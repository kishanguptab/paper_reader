# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Where your PDFs live (default: ./papers, or the parent folder if it contains PDFs)
# PAPERLENS_PAPERS_DIR=~/Documents/papers
# PAPERLENS_DATA_DIR=./data

# Models: fast = paragraph explanations + library-wide cards; smart = deep reads; chat = agent
# PAPERLENS_FAST_MODEL=claude-haiku-5-5
# PAPERLENS_SMART_MODEL=claude-sonnet-5-5
# PAPERLENS_CHAT_MODEL=claude-sonnet-5-5

# Hard spending cap in USD across all calls (tracked in the local ledger)
# PAPERLENS_BUDGET_USD=20
